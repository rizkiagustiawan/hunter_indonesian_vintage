[Unit]
Description=FBM Vintage Monitor (VPS Edition - Go)
After=network.target

[Service]
Type=simple
User=awan
WorkingDirectory=/home/awan/Documents/fbm-vintage-monitor
ExecStart=/home/awan/Documents/fbm-vintage-monitor/fbm-monitor
Restart=on-failure
RestartSec=60

[Install]
WantedBy=multi-user.target
